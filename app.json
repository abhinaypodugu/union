{
  "expo": {
    "name": "Union",
    "slug": "union",
    "owner": "abhinaypodugu200s-team",
    "scheme": "union",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "org.commons.union",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.commons.union",
      "versionCode": 2,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E40AF"
      }
    },
    "splash": {
      "backgroundColor": "#FAF8F5"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#1E40AF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to let you set your profile photo.",
          "cameraPermission": "The app needs access to your camera to let you take a profile photo."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8d4a58e3-03da-4a80-8df7-2d641bd7aaf5"
      }
    }
  }
}
